# Copy to .env and fill in. Never commit .env.
# Signs admin session cookies. In production an unset key now falls back to a
# random per-boot secret (admins re-sign-in after each restart) - set a fixed
# one: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Store owner login and system/order-notification inbox.
ADMIN_EMAIL=jaurastore@gmail.com

# ------------------------------------------------- permanent admin passwords
# ADMIN_MASTER_PASSWORD is the PRIMARY master password for the admin portal.
# It is read from the environment for every login attempt, so updating the
# value in the host dashboard works on the very next login - no database
# change. Long and unique: it opens the whole shop admin.
# ADMIN_MASTER_PASSWORD=

# ADMIN_BOOTSTRAP_PASSWORD is the secondary/permanent fallback credential
# (and remains effective on its own when no master password is set). Set it
# privately in the host dashboard; never commit either value.
ADMIN_BOOTSTRAP_PASSWORD=

# ------------------------------------------------------ Google reCAPTCHA v2
# The shop renders reCAPTCHA v2 INVISIBLY (size:"invisible"): there is no
# "I'm not a robot" box, the widget mints a token when the shopper submits.
# Register the site at https://www.google.com/recaptcha/admin as
#   type:    reCAPTCHA v2 -> "Invisible reCAPTCHA badge"
#   domains: jaurastore.com.ng AND www.jaurastore.com.ng
# A v3 key (or a v2 Checkbox key) here is what makes Google answer
# "Invalid key type".
# The site key is public - it is sent to the browser by /api/config - so it
# has a working default in config.py. The secret key is server-side only and
# has no default: without it verification is skipped and nothing is blocked.
# RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# v3-style minimum score; inert for v2 (v2 answers carry no score).
# RECAPTCHA_MIN_SCORE=0.3
# REQUIRED=1 would reject requests that arrive WITHOUT a token. Leave it off:
# queued offline orders (whose token expired with no signal) must still
# arrive, and checkout is never blocked behind the widget.
# RECAPTCHA_REQUIRED=

# Email delivery. Customer messages use each customer's explicit address,
# while owner notifications use ADMIN_EMAIL. MAIL_TO is not supported.
MAIL_FROM=orders@jaurastore.com.ng
RESEND_API_KEY=

# Site origin used for canonical links
SITE_ORIGIN=http://localhost:8080

# Keep the free host awake: the scheduler pings SITE_ORIGIN/healthz each tick.
# Defaults to on when SITE_ORIGIN is set; set to 0 to disable.
# KEEP_ALIVE=1

# ---------------------------------------------------------------- Supabase
# Set these to make Supabase the source of truth for products, carts, orders
# and admin auth. When unset, the shop falls back to local files / SQLite.
# The SERVICE_ROLE_KEY is server-side only (used by the Flask app) and must
# NEVER be shipped to the browser. SUPABASE_KEY is accepted as an alias for it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------- Google Sheets accounting
# Configure an OAuth 2.0 Web application in Google Cloud. Add the exact
# redirect URI below to the OAuth client's Authorized redirect URIs. The
# owner connects their own Google account from Admin -> Accounting; the app
# creates the Naira and CFA workbooks in that account's Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/admin/accounting/google/callback
# The owner's ITEMFLOW reference workbook: pushes land on its NGN / FCFA tabs.
# A value saved on the accounting desk ("Reference spreadsheet") wins over
# this; blank falls back to the built-in id below.
GOOGLE_SHEET_ID=1GnBgXl-VNoRzV-jiz4qCeb_BKzs31_Fu
# Optional dedicated stable key for encrypting the stored Google refresh token.
# If empty, the stable SECRET_KEY is used. Generate with `python -c
# "import secrets; print(secrets.token_urlsafe(48))"` and keep it private.
GOOGLE_SHEETS_TOKEN_KEY=
# SUPABASE_KEY=            # optional alias for SUPABASE_SERVICE_ROLE_KEY
# Optional: the Postgres pooler connection string (Dashboard -> Project
# Settings -> Database). When set, auto_migrate.py can create a missing
# site_settings column straight from the app on boot instead of waiting
# for a manual SQL-editor run. Same value migrate_supabase.py --schema
# already uses.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:6543/postgres

# ------------------------------------------------------ GitHub repo sync
# Optional. When set, repo_sync.py (called after admin product changes and
# from the admin "Sync to GitHub" button) regenerates the catalogue data files
# and commits/pushes them, so admin edits survive a redeploy and the GitHub
# repo stays in sync with Supabase. Without these the data files are still
# written locally and included on the next normal deploy.
GITHUB_TOKEN=
GITHUB_REPOSITORY=            # e.g. praisejudith03-collab/jaurastore
GITHUB_BRANCH=main
# GITHUB_COMMITTER="Jaura Store Sync <jaurastore@gmail.com>"
REPO_SYNC_ON_WRITE=1

# Uploads: local disk (data/uploads), S3/R2-compatible storage, or Supabase
# Storage. With UPLOAD_MODE=supabase the app uploads to the project's
# Supabase bucket using SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above
# (the sole supported bucket is uploads, PUBLIC; overrides are ignored).
# Proofs use random paths and signed links, but anyone who knows the public
# object URL can read them. Signed URLs do NOT make the public bucket private.
# Production failures never fall back to local disk. /uploads/... continues
# to serve legacy disk files; local writes are test-only.
UPLOAD_MODE=local
# SUPABASE_BUCKET=uploads
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=
