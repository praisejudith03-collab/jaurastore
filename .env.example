# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string

# Admin login email(s) — the only accounts that can sign in to /admin.html
ADMIN_EMAILS=jaurastore@gmail.com

# Mail (receipts). Gmail SMTP with an App Password, or Resend.
MAIL_MODE=none
MAIL_FROM=jaurastore@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jaurastore@gmail.com
# SMTP_PASS=<gmail app password>
# RESEND_API_KEY=

# Site origin used in emails / canonical links
SITE_ORIGIN=http://localhost:8080

# ---------------------------------------------------------------- Supabase
# Set these to make Supabase the source of truth for products, carts, orders
# and admin auth. When unset, the shop falls back to local files / SQLite.
# The SERVICE_ROLE_KEY is server-side only (used by the Flask app) and must
# NEVER be shipped to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Uploads: local disk (data/uploads) or S3/R2-compatible storage
UPLOAD_MODE=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=
