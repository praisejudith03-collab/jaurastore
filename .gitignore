# Local environment / secrets — never commit
.env
*.local

# Stray copies of git's own internals. They were committed once (and then
# served over HTTP by the catch-all route), and they make git arguments
# ambiguous — `git rm -- index` needs the `--` because `index` is a file here.
# Anchored to the repo root so a real file named e.g. js/index.html is safe.
/HEAD
/index
/main
/description
/exclude
/*.sample

# Python
__pycache__/
*.py[cod]
.venv/
.venv-test/
venv/
.pytest_cache/
.mypy_cache/

# Runtime data that must live on a persistent disk (Render uses /var/data)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db.consistent-snapshot
data/uploads/
catalog.json.bak
catalog.json.lock
catalog.json.tmp
data/outbox/
data/uploads/
.git-repo-sync.lock
node_modules/
data/backups/orders-backup.json

# Migration reports are per-run artifacts, never source
supabase_migration_report.json
receipts_migration.json
migration-dry-run.json
migration-result.json
migration-*.json

# Editor backups must never ship
*.bak

# Local verification artifacts and temporary preview configuration
.cache/
# The pytest JUnit report tools/ci_check.sh writes (CI uploads its own copy as
# an artifact). It is a per-run result, never source.
pytest-results.xml
data/.analytics-restore.lock

# Supplier stock sync (tools/supplier_stock_sync.py) run artifacts: an image
# fingerprint cache and a per-run "needs human review" report - both are
# regenerated every run, never source.
supplier_sync_cache.json
supplier_match_review.json
supplier_sync_warnings.json
# One-time/scheduled supplier audit report
supplier-sync-report.json
